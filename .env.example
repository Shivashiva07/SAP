# ── Google OAuth2 client (from Google Cloud Console → APIs & Services → Credentials) ──
# Create an "OAuth client ID" of type "Web application" and add the redirect URI below
# to its "Authorized redirect URIs" list.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# Obtained once by running `npm run get-token` (see README) — do NOT commit the real value.
GOOGLE_REFRESH_TOKEN=

# ── Target Google Sheet ──
# The long ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your-google-sheet-id
# Name of the tab attendance rows are written to (created automatically if missing)
SHEET_TAB_NAME=Attendance

# ── App server ──
PORT=5000
# Optional: IANA timezone for the Date/Time written to the sheet (e.g. Asia/Kolkata)
TZ=Asia/Kolkata

# Portal display name shown in the header
PORTAL_NAME=Student Attendance Portal
